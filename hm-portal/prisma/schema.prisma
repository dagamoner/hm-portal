// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Role {
  ADMIN
  MANAGER
  INSPECTOR
  CLIENT
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String?  @unique
  password  String
  name      String
  role      Role     @default(CLIENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
}

// ==========================================
// RIESGOS MODULE - HIERARCHICAL MODELS
// ==========================================

model Establishment {
  id               String   @id @default(uuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  name             String
  address          String?
  province         String?
  municipality     String?
  coordinates      String?
  type             String?
  startDate        DateTime?
  coveredArea      Float?
  uncoveredArea    Float?
  floors           Int?
  buildingAge      Int?
  
  // JSON fields for grouped extensive data
  regulatoryRegime Json?    // Actividad general, construcción, jurisdicción, etc.
  organization     Json?    // Organigrama, responsables, etc.
  staffing         Json?    // Dotación: propios, contratados, etc.
  operation        Json?    // Funcionamiento: turnos, horarios, etc.
  production       Json?    // Producción: productos, capacidad, etc.
  background       Json?    // Antecedentes: inspecciones, intimaciones
  emergencies      Json?    // Emergencias: servicios externos, distancias
  
  sectors          Sector[]
  workers          Worker[]
  visits           Visit[]
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Sector {
  id               String   @id @default(uuid())
  establishmentId  String
  establishment    Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  
  name             String
  description      String?
  area             Float?
  height           Float?
  maxOccupants     Int?
  
  // JSON field for physical details (circulaciones, escaleras, instalaciones, etc.)
  physicalDetails  Json?
  
  processes        Process[]
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Process {
  id               String   @id @default(uuid())
  sectorId         String
  sector           Sector   @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  
  name             String
  description      String?
  
  // JSON field for process details (materias primas, equipos, temperaturas, residuos, etc.)
  processDetails   Json?
  
  jobRoles         JobRole[]
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model JobRole {
  id               String   @id @default(uuid())
  processId        String
  process          Process  @relation(fields: [processId], references: [id], onDelete: Cascade)
  
  name             String
  personnelCount   Int?
  shifts           String?
  
  // JSON field for job role details (competencias, EPP, rotación, etc.)
  roleDetails      Json?
  
  tasks            Task[]
  workers          Worker[]
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Task {
  id               String   @id @default(uuid())
  jobRoleId        String
  jobRole          JobRole  @relation(fields: [jobRoleId], references: [id], onDelete: Cascade)
  
  name             String
  description      String?
  type             String? // rutinaria, no rutinaria, emergencia
  
  // JSON field for task details (frecuencia, duración, lugar, etc.)
  taskDetails      Json?
  
  hazards          Hazard[]
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Hazard {
  id               String   @id @default(uuid())
  taskId           String
  task             Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  
  name             String?
  description      String?
  type             String?
  
  category         String?  // Legacy
  source           String?  // Legacy
  event            String?  // Legacy
  consequence      String?  // Legacy
  exposedCount     Int?     // Personas expuestas
  
  evaluations      RiskEvaluation[]
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model RiskEvaluation {
  id               String   @id @default(uuid())
  hazardId         String
  hazard           Hazard   @relation(fields: [hazardId], references: [id], onDelete: Cascade)
  
  probability      Int?
  severity         Int?
  riskLevel        Int?
  controlMeasures  String?
  
  // Inherent Risk
  initialProbability Int?
  initialSeverity    Int?
  inherentRisk       Int?
  
  // Existing Controls
  existingControls   Json?    // Array of existing controls
  
  // Residual Risk
  residualProbability Int?
  residualSeverity    Int?
  residualRisk        Int?
  
  // Objective Risk
  objectiveProbability Int?
  objectiveSeverity    Int?
  objectiveRisk        Int?
  
  priorityIndex      Float?   // Calculated priority
  status             String   @default("Borrador") // Borrador, Validado, Aprobado
  
  evaluatorId        String?
  observations       String?
  
  improvementActions ImprovementAction[]
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ImprovementAction {
  id               String   @id @default(uuid())
  evaluationId     String
  evaluation       RiskEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  
  description      String
  hierarchy        String   // Eliminación, sustitución, ingeniería, admin, EPP
  status           String   @default("Pendiente")
  priority         String?
  
  deadline         DateTime?
  responsible      String?
  
  actionDetails    Json?    // Costo, indicador de avance, evidencias, reevaluación, etc.
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Worker {
  id               String   @id @default(uuid())
  establishmentId  String?
  establishment    Establishment? @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  
  companyId        String?
  company          Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  firstName        String
  lastName         String
  documentId       String   // DNI / Legajo
  
  primaryRoleId    String?
  primaryRole      JobRole? @relation(fields: [primaryRoleId], references: [id], onDelete: SetNull)
  
  // JSON fields for medical and functional data
  functionalData   Json?    // Apto, restricciones (NO DATOS CLÍNICOS)
  laborData        Json?    // EPP, capacitaciones, turnos, etc.
  exposures        Json?    // Relación con agentes de riesgo específicos
  
  safetyScore      Int      @default(100)
  permits          PermitToWork[]
  trainingRecords  TrainingRecord[]
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Company {
  id                  String   @id @default(uuid())
  name                String
  legalName           String?
  owner               String
  taxId               String   @unique
  address             String
  workContact         String
  insuranceART        String
  selfInsured         Boolean  @default(false)
  establishmentsCount Int      @default(1)
  workersAdmin        Int      @default(0)
  workersOps          Int      @default(0)
  keyData             String?
  remarks             String?
  artUser             String?
  artPass             String?
  industry            String
  secondaryActivity   String?
  activityCode        String?
  riskLevel           RiskLevel @default(MEDIUM)
  status              String   @default("Activa")
  safetyCompliance    Float    @default(0)
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  users               User[]
  incidents           Incident[]
  inspections         Inspection[]
  measurements        MeasurementRecord[]
  documents           Document[]
  ergonomicEvals      ErgonomicEvaluation[]
  cancerigenoEvals    CancerigenoEvaluation[]
  investigations      Investigation[]
  visits              Visit[]
  visitFindings       VisitFinding[]
  checklistTemplates  ChecklistTemplate[]
  
  // New Relations for Risk Module
  establishments      Establishment[]
  
  // New Relation for Vehicle Module
  vehicles            Vehicle[]
  
  // New Relation for Equipment Module
  equipments          Equipment[]
  
  // New Relation for Personal & PTW Module
  workers             Worker[]
  permits             PermitToWork[]
  auditLogs           AuditLog[]
  
  // New Relations for Training Module
  trainingPlans       TrainingPlan[]
  trainings           Training[]
  trainingRecords     TrainingRecord[]
}

model CancerigenoEvaluation {
  id          String   @id @default(uuid())
  year        Int
  
  // Stored as JSON to handle dynamic structure of 81/19
  responsables Json     @default("{}")
  puestos      Json     @default("[]")
  sustancias   Json     @default("[]")
  medidas      Json     @default("[]")
  
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ErgonomicEvaluation {
  id          String   @id @default(uuid())
  jobPosition String
  sector      String
  workerName  String?
  date        DateTime @default(now())
  
  // Stored as JSON to handle dynamic structure of 886/15
  planilla1   Json     @default("{}")
  planilla2   Json     @default("{}")
  planilla3   Json     @default("{}")
  planilla4   Json     @default("{}")
  
  globalStatus String  @default("Pendiente")
  
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Incident {
  id          String   @id @default(uuid())
  title       String
  date        DateTime
  location    String
  severity    RiskLevel
  status      String   @default("Abierto")
  description String
  details     Json     @default("{}")
  
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  
  investigation Investigation?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Inspection {
  id          String   @id @default(uuid())
  title       String
  location    String
  date        DateTime
  status      String   @default("En Progreso")
  score       Float    @default(0)
  
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  
  items       Json     @default("[]")
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MeasurementRecord {
  id          String   @id @default(uuid())
  type        String
  area        String
  value       Float
  unit        String
  instrument  String
  date        DateTime
  status      String   @default("Pendiente")
  
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  
  details     Json     @default("{}")
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum DocumentCategory {
  LEGAL
  PERSONAL
  ACTIVOS
  PROCEDIMIENTOS
}

enum DocumentStatus {
  VIGENTE
  POR_VENCER
  VENCIDO
  CERRADO
}

model Investigation {
  id          String   @id @default(uuid())
  incidentId  String   @unique
  incident    Incident @relation(fields: [incidentId], references: [id])
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  status      String   @default("En Progreso") // En Progreso, Completada
  methodology String   @default("5porques")
  cause       String?
  actionPlan  String?
  analysisData Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Document {
  id             String           @id @default(uuid())
  title          String
  category       DocumentCategory
  status         DocumentStatus   @default(VIGENTE)
  uploadDate     DateTime         @default(now())
  expirationDate DateTime?
  fileUrl        String?
  
  companyId      String
  company        Company          @relation(fields: [companyId], references: [id])
  
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model Vehicle {
  id          String   @id @default(uuid())
  type        String   
  brand       String
  model       String
  plate       String
  mileage     Int?
  hours       Int?
  year        Int
  status      String   @default("Disponible")
  
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Equipment {
  id          String   @id @default(uuid())
  name        String
  category    String   
  status      String   @default("Operativo") 
  hours       Int      @default(0)
  
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  
  interventions Intervention[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Intervention {
  id          String   @id @default(uuid())
  type        String   
  date        DateTime
  description String
  
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
}

model PermitToWork {
  id              String   @id @default(uuid())
  workerId        String
  worker          Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  taskDescription String
  hazards         Json     @default("[]") 
  ppe             Json     @default("[]") 
  preventions     Json     @default("[]") 
  
  issueDate       DateTime @default(now())
  expirationDate  DateTime
  
  status          String   @default("Vigente") 
  signatureId     String?  
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AuditLog {
  id          String   @id @default(uuid())
  timestamp   DateTime @default(now())
  
  userId      String?
  userName    String
  userRole    String
  
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  module      String
  action      String   // CREAR, MODIFICAR, ELIMINAR, LOGIN, ACCESO_DENEGADO
  target      String
  severity    String   @default("INFO") // INFO, WARNING, CRITICAL
  details     Json?    
}

// ==========================================
// VISITS AND INSPECTIONS MODULE
// ==========================================

model Visit {
  id                 String   @id @default(uuid())
  establishmentId    String
  establishment      Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  companyId          String
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  date               DateTime
  visitNumber        Int?
  inspectorName      String
  
  observations       String?
  recommendedTrainings String?
  
  checklistData      Json?
  
  findings           VisitFinding[]
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model VisitFinding {
  id                 String   @id @default(uuid())
  visitId            String
  visit              Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  companyId          String
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  description        String
  hazardLevel        String?  // Ej. Alto, Medio, Bajo
  status             String   @default("ABIERTO") // ABIERTO, EN_PROGRESO, CERRADO
  deadline           DateTime?
  actionPlan         String?
  resolutionDate     DateTime?
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model ChecklistTemplate {
  id                 String   @id @default(uuid())
  companyId          String?  // Si es null, es global para el sistema. Si tiene valor, es un template custom de la empresa.
  company            Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  name               String   // "Establecimiento General", "Obra Construcción"
  type               String   // "ESTABLECIMIENTO", "OBRA"
  
  categories         Json     // Array of categories with items
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ==========================================
// CAPACITACIONES Y COMPETENCIAS MODULE
// ==========================================

model TrainingPlan {
  id          String   @id @default(uuid())
  year        Int
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  trainings   Training[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([companyId, year])
}

model Training {
  id              String   @id @default(uuid())
  planId          String
  plan            TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  title           String
  description     String?
  monthIndex      Int      // 1-12
  type            String   // Operativo, Gerencial, Salud, Ingeniería
  priority        String   // Obligatoria, Recomendada
  externalLink    String?  // Google Form URL
  status          String   @default("Bloqueada") // Bloqueada, Pendiente, En Progreso, Completada
  
  records         TrainingRecord[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model TrainingRecord {
  id              String   @id @default(uuid())
  trainingId      String
  training        Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  workerId        String
  worker          Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  completed       Boolean  @default(false)
  approved        Boolean?
  score           Float?
  certificateId   String?  // Ej: 6B11DO-CE000006
  completionDate  DateTime?
  expirationDate  DateTime?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([trainingId, workerId])
}
